<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasks</title>
    <link rel="stylesheet" href="/tasks.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
</head>
<body>
    <div class="bar">
        <div class="icon">
            <a href="http://localhost:8000/projects">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </div>
        <div class="head">
            <h1><%=project.name%></h1>
        </div>
        <form method="post" action="http://localhost:8000/projects/<%=project.id%>?_method=DELETE">
            <button class="dbtn">
                Delete Project
            </button>
        </form>
    </div>
    <div class="body">
        <div class="snf">
            <div class="f">
                <p>
                    Filter:
                </p>
                <a href="http://localhost:8000/projects/<%=project.id%>?filter=all&sortPriority=<%=sortPriority?'1':''%>&sortDate=<%=sortDate?'1':''%>">
                    <div class="btn <%=filter == 'all' ? 'active' : ''%>">All</div>
                </a>
                <a href="http://localhost:8000/projects/<%=project.id%>?filter=done&sortPriority=<%=sortPriority?'1':''%>&sortDate=<%=sortDate?'1':''%>">
                    <div class="btn <%=filter == 'done' ? 'active' : ''%>">Done</div>
                </a>
                <a href="http://localhost:8000/projects/<%=project.id%>?filter=undone&sortPriority=<%=sortPriority?'1':''%>&sortDate=<%=sortDate?'1':''%>">
                    <div class="btn <%=filter == 'undone' ? 'active' : ''%>">Not done</div>
                </a>
            </div>
            <div class="s">
                <p>
                    Sort:
                </p>
                <a href="/projects/<%=project.id%>?filter=<%=filter%>&sortPriority=<%= sortPriority ? '' : '1' %>&sortDate=<%= sortDate ? '1' : '' %>">
                    <div class="btn <%= sortPriority ? 'active' : '' %>">
                        Priority
                        <i class="fa-solid fa-sort-down"></i>
                    </div>
                </a>
                <a href="/projects/<%=project.id%>?filter=<%=filter%>&sortPriority=<%= sortPriority ? '1' : '' %>&sortDate=<%= sortDate ? '' : '1' %>">
                    <div class="btn <%= sortDate ? 'active' : '' %>">
                        Due date
                        <i class="fa-solid fa-sort-down"></i>
                    </div>
                </a>
            </div>
        </div>
        <div class="tasks">
            <%for(task of ftasks){%>
            <div class="task">
                <form method="post" action="http://localhost:8000/projects/<%=project.id%>/tasks/<%=task.id%>/toggle?_method=PATCH">
                    <input type="checkbox" name="check" class="check" <%= task.done ? "checked" : "" %> onchange="this.form.submit()">
                </form>
                <p class="name <%= task.done ? 'done' : '' %>">
                    <%=task.title%>    
                </p>
                <div class="common <%=task.priority%>">
                    <%=task.priority%>
                </div>
                <div class="due">
                    <%=task.dueDate%>
                </div>
                <a href="http://localhost:8000/projects/<%=project.id%>/tasks/<%=task.id%>/edit">
                    <i class="fa-solid fa-pen edit" style="font-size: 14px;"></i>
                </a>
                <form method="post" action="http://localhost:8000/projects/<%=project.id%>/tasks/<%=task.id%>?_method=DELETE">
                    <button>
                        <i class="fa-solid fa-trash delete"></i>
                    </button>
                </form>
            </div>
            <%}%>
        </div>
        <form class="form" method="post" action="http://localhost:8000/projects/<%=project.id%>/tasks">
            <h3>Add a Task</h3>
            <div class="input">
                <input type="text" placeholder="Title" name="title" class="title">
                <input type="date" name="date" class="date">
                <select name="priority" id="priority" class="priority">
                    <option value="" disabled selected hidden>Priority</option>
                    <option value="high">high</option>
                    <option value="mid">mid</option>
                    <option value="low">low</option>
                </select>
            </div>
            <a>
                <button class="add">+ Add Task</button>
            </a>
            <%if(errorMsg){%>
                <p>
                    <i class="fa-solid fa-triangle-exclamation" style="color: rgb(232, 138, 138)"></i>&nbsp;
                    <%=errorMsg%>
                </p>
            <%}%>
        </form>
    </div>
</body>
</html>