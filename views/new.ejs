<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Project</title>
    <link rel="stylesheet" href="/new.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css">
</head>
<body>
    <div class="bar">
        <div class="icon">
            <a href="/projects">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
        </div>
        <div class="head">
            <h1>All Projects</h1>
        </div>
    </div>
    <form method="post" action="/projects">
        <div class="card">
            <h2>New Project</h2>
            <div class="project">
                <div class="name">
                    Project Name
                </div>
                <div class="input">
                    <input type="text" name="name" placeholder="e.g. Gym Routine">
                </div>
            </div>
            <div class="btns">
                <a>
                    <button class="btn p">Create Project</button>
                </a>
                <a href="/projects">
                    <button class="btn c" type="button">Cancel</button>
                </a>
            </div>
            <%if(errorMsg){%>
                <p>
                    <i class="fa-solid fa-triangle-exclamation" style="color: rgb(232, 138, 138)"></i>&nbsp;
                    <%=errorMsg%>
                </p>
            <%}%>
        </div>
    </form>
</body>
</html>